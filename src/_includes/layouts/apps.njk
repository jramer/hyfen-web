<!doctype html>
{% set lang = lang or "en" %}
{% set t = appsI18n[lang] %}
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    {%- if canonicalPath %}
    <link rel="canonical" href="{{ appsI18n.base }}{{ canonicalPath }}">
    {%- if altPath %}
    <link rel="alternate" hreflang="{{ lang }}" href="{{ appsI18n.base }}{{ canonicalPath }}">
    <link rel="alternate" hreflang="{{ altLang }}" href="{{ appsI18n.base }}{{ altPath }}">
    <link rel="alternate" hreflang="x-default" href="{{ appsI18n.base }}/attic/">
    {%- endif %}
    {%- endif %}
    <link rel="icon" type="image/svg+xml" href="/assets/attic-icon.svg">
    <link rel="stylesheet" href="/assets/apps.css">
  </head>
  <body class="{{ page_class }}">
    {%- if altPath %}
    <div class="wrap"><nav class="lang" aria-label="Language"><a href="{{ t.switchHref }}" hreflang="{{ t.switchLang }}" lang="{{ t.switchLang }}">{{ t.switchLabel }}</a></nav></div>
    {%- endif %}
    {% if page_class == 'prose' %}<main class="wrap">{{ content | safe }}<a class="home-link" href="/attic">About Attic</a></main>{% else %}{{ content | safe }}{% endif %}
    <div class="wrap">
      <footer>
        <p>{{ metadata.company.name }} &middot; {{ t.orgLabel }} {{ metadata.company.orgnr }}</p>
        <p><a href="mailto:attic@hyfen.se">attic@hyfen.se</a></p>
        <nav aria-label="{{ t.legalLabel }}">
          <a href="/privacy">{{ t.privacy }}</a>
          <a href="https://www.apple.com/legal/internet-services/itunes/dev/stdeula/">{{ t.terms }}</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
