---
layout: layouts/base.njk
---
{% set lang = lang or "sv" %}
{% set t = i18n[lang] %}
<main class="hero">
  <a class="lang-switch" href="{{ t.switchHref | url }}" hreflang="{{ t.switchLang or (lang == 'sv' and 'en' or 'sv') }}">{{ t.switchLabel }}</a>

  <div class="card">
    <img class="logo" src="{{ '/img/hyfen.png' | url }}" width="595" height="595"
         alt="Hyfen AB" />
    <p class="tagline">{{ t.tagline }}</p>

    {% set emailParts = metadata.author.email | split("@") %}
    <nav class="contact" aria-label="{{ t.contactLabel }}">
      <a class="email" href="#" data-user="{{ emailParts[0] }}" data-domain="{{ emailParts[1] }}">{{ t.email }}</a>
      <a href="{{ metadata.social.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
      <a href="{{ metadata.social.github }}" target="_blank" rel="noopener">GitHub</a>
      <a href="https://apps.hyfen.se/">{{ t.appsLabel }}</a>
    </nav>
    <noscript><p class="email-fallback">{{ emailParts[0] }} {{ t.atWord }} {{ emailParts[1] }}</p></noscript>
  </div>

  <footer class="legal">
    {{ metadata.company.name }} &middot; {{ t.orgLabel }} {{ metadata.company.orgnr }}
  </footer>
</main>
